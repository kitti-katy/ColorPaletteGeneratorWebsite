import Color from "../../utilities/Color";
export const getWidthScaler = () => window.innerWidth >= 1920 ? 1 : window.innerWidth / 1920
export const getScaledHueWidth = () => 360 * getWidthScaler()

export const getWidthScaler = () => window.innerWidth >= 1920 ? 1 : window.innerWidth / 1920
export const getScaledHueWidth = () => 360 * getWidthScaler()

export const drawHueCanvas = (baseColor) => {
    let scaler = getWidthScaler() //w >= 1920 ? 1 : w/1920

    let sat = baseColor.hsl.sat;
    let canvas = document.getElementById("main-canvas-color-picker");
    let ctx = canvas.getContext("2d");
    let scaledWidth = getScaledHueWidth()
    for (let i = 0; i < scaledWidth; i += scaler) {
        var gradient = ctx.createLinearGradient(i, 0, i, 200);
        let scaledBackHue = Math.round(i * 360 / scaledWidth)
        console.log(scaledBackHue)
        gradient.addColorStop(0, "hsl(" + scaledBackHue + "," + sat + "%,0%)");
        gradient.addColorStop(0.5, "hsl(" + scaledBackHue + "," + sat + "%,50%)");
        gradient.addColorStop(1, "hsl(" + scaledBackHue + "," + sat + "%,100%)");
        ctx.fillStyle = gradient;
        ctx.fillRect(i, 0, i, 200);
    }
}

export const drawSaturationCanvas = (baseColor) => {
    let hue = baseColor.hsl.hue;
    let light = baseColor.hsl.light;
    let canvas = document.getElementById("saturation-canvas-color-picker");
    let ctx = canvas.getContext("2d");
    for (let j = 0; j < 202; j += 2) {
        for (let i = 0; i < 10; i += 1) {
            ctx.fillStyle = "hsl(" + hue + ", " + j / 2 + "%, " + light + "%)";
            ctx.fillRect(i, j, i, j + 2);
        }
    }
}

export const getColorHueCanvas = (clientX, clientY, baseColor) => {
    let canvas = document.getElementById("main-canvas-color-picker");
    let rect = canvas.getBoundingClientRect();
    let x = clientX - rect.left;
    let y = clientY - rect.top;
    let scaledBackX = Math.round(x * 360 / getScaledHueWidth())
    let hue = Math.round(scaledBackX);
    let sat = baseColor.hsl.sat;
    let light = Math.round(y / 2);
    let color = new Color(hue, sat, light, "HSL");
    return color
}

export const getColorSaturationCanvas = (clientY, baseColor) => {
    let canvas = document.getElementById("saturation-canvas-color-picker");
    let rect = canvas.getBoundingClientRect();
    let y = clientY - rect.top;
    if (y < 0 || y > 200) return;
    let hsl = baseColor.hsl;
    let hue = hsl.hue;
    let sat = Math.round(y / 2);
    let light = hsl.light;
    let color = new Color(hue, sat, light, "HSL");
    return color
}


import React, { Component } from "react";
import Color from "../../utilities/Color";
import { Throttle } from "react-throttle";
import {drawHueCanvas, drawSaturationCanvas, getColorSaturationCanvas, getColorHueCanvas, getScaledHueWidth} from './drawColorCanvases'

class ColorPickerCanvas extends Component {
    state = {
        allowClrChange: false,
        allowSatChange: false,
        mouseDownMainCanvas: false,
        mouseDownSatCanvas: false,

        pickerCirclePositionX: 0,
        pickerCirclePositionY: 0,
        saturationRectPositionY: 0,

        selectedColor: new Color('#edb407', 0, 0, 'Hex'),
        hexValue: 'edb407'
    };
    componentDidMount = () => {
        drawHueCanvas(this.props.baseColor);
        drawSaturationCanvas(this.props.baseColor);
        document.addEventListener("mouseup", this.setMouseDownToFalse, false);
        document.addEventListener("mouseup", this.setSatMouseDownToFalse, false);
    };

    enableColorChange = () => this.setState({ allowClrChange: true });
    disableColorChange = () => this.setState({ allowClrChange: false });

    handleMouseDownMainCanvas = evt => {
        this.setMouseDownToTrue();
        this.enableColorChange();
        this.setColorFromMainCanvas(evt.clientX, evt.clientY);
    };
    handleMouseMoveMainCanvas = evt => {
        if (this.state.mouseDownMainCanvas && this.state.allowClrChange)
            this.setColorFromMainCanvas(evt.clientX, evt.clientY);
    };
    setMouseDownToTrue = () => this.setState({ mouseDownMainCanvas: true });
    setMouseDownToFalse = () => this.setState({ mouseDownMainCanvas: false });

    setColorFromMainCanvas = (clientX, clientY) => {
        let color = getColorHueCanvas(clientX, clientY, this.props.baseColor)
        this.setState({ selectedColor: color })
        this.props.onChange(color);
        drawSaturationCanvas(color);
        this.props.setHexInput(color.HEXString.substring(1))
    };

    handleMouseDownSatCanvas = evt => {
        this.setSatMouseDownToTrue();
        this.enableColorChange();
        this.setColorFromSatCanvas(evt.clientY);
    };
    handleMouseMoveSatCanvas = evt => {
        if (this.state.mouseDownSatCanvas && this.state.allowClrChange)
            this.setColorFromSatCanvas(evt.clientY);
    };
    setSatMouseDownToTrue = () => this.setState({ mouseDownSatCanvas: true });
    setSatMouseDownToFalse = () => this.setState({ mouseDownSatCanvas: false });

    setColorFromSatCanvas = clientY => {
        let color = getColorSaturationCanvas(clientY, this.props.baseColor)
        this.props.onChange(color);
        this.setState({ selectedColor: color })
        drawHueCanvas(color);
        this.props.setHexInput(color.HEXString.substring(1))
    };

    render() {
        let baseColor = this.props.baseColor;
        const { hue, sat, light } = baseColor.hsl
        let hexString = baseColor.HEXString;

        return (
            <div id="canvases-container">
                <div>
                    <div id="pickerCircle" style={{ borderColor: light > 50 ? "#757575" : "white", marginLeft: hue - 8 + "px", marginTop: light * 2 - 8 + "px", backgroundColor: hexString }} />
                    <Throttle time="20" handler="onMouseMove">
                        <canvas height="200" width={getScaledHueWidth()} id="main-canvas-color-picker"
                            onMouseDown={this.handleMouseDownMainCanvas} onMouseMove={this.handleMouseMoveMainCanvas}
                            onMouseLeave={this.disableColorChange} onMouseEnter={this.enableColorChange} />
                    </Throttle>
                </div>

                <div style={{ marginLeft: "10px" }}
                    onMouseDown={this.handleMouseDownSatCanvas} onMouseMove={this.handleMouseMoveSatCanvas}
                    onMouseLeave={this.disableColorChange} onMouseEnter={this.enableColorChange}>
                    <div id="saturationCircle" style={{ backgroundColor: hexString, borderColor: light > 50 ? "#757575" : "#d9d9d9", marginTop: sat * 2 - 5 + "px" }} />
                    <canvas id="saturation-canvas-color-picker" height="200" width="10" />
                </div>

            </div>
        );
    }
}
export default ColorPickerCanvas;


import React, { Component } from "react";
import Color from "../../utilities/Color";
import { changeBaseColor } from "../../redux/BaseColorReducer";
import { bindActionCreators } from "redux";
import { connect } from "react-redux";
import { Throttle } from "react-throttle";
import { Input } from 'antd';
import './ColorPicker.css'
import { Card, Label, NumericInput } from "@blueprintjs/core";
import ColorPickerCanvas from './ColorPickerCanvas'
import {drawHueCanvas, drawSaturationCanvas} from './drawColorCanvases'


let mapStateToProps = (state) => { return { baseColor: state.BaseColorReducer.baseColor }; }
let mapDispatchToProps = (dispatch) => { return bindActionCreators({ changeBaseColor: changeBaseColor }, dispatch); }

class ColorPicker extends Component {
  state = {
    selectedColor: new Color('#edb407', 0, 0, 'Hex'),
    hexValue: 'edb407'
  };
  componentDidMount = () => {
  };

  handleFormInput = color => {
    this.props.changeBaseColor(color);
    drawHueCanvas(color);
    drawSaturationCanvas(color);
    this.setHexInput(color.HEXString.substring(1))
  };
  setHexInput = (val) => { this.setState({ hexValue: val }); }
  getNumberPickerInput = (id, max, val, onChange) =>
    <NumericInput size="small" style={{ width: '60px', display: 'inline', marginLeft: '2px' }} type="number" id={id} min="0" max={max} value={val} onValueChange={onChange} />

  // Input Setters
  setFromHue = value => this.handleFormInput(new Color(value, this.props.baseColor.hsl.sat, this.props.baseColor.hsl.light, "HSL"))
  setFromSat = value => this.handleFormInput(new Color(this.props.baseColor.hsl.hue, value, this.props.baseColor.hsl.light, "HSL"))
  setFromLight = value => this.handleFormInput(new Color(this.props.baseColor.hsl.hue, this.props.baseColor.hsl.sat, value, "HSL"))
  setFromRed = value => this.handleFormInput(new Color(value, this.props.baseColor.rgb.g, this.props.baseColor.rgb.b, "RGB"))
  setFromGreen = value => this.handleFormInput(new Color(this.props.baseColor.rgb.r, value, this.props.baseColor.rgb.b, "RGB"))
  setFromBlue = value => this.handleFormInput(new Color(this.props.baseColor.rgb.r, this.props.baseColor.rgb.g, value, "RGB"))
  setFromHex = e => {
    let val = e.target.value
    if (val.length < 7) {
      this.setState({ hexValue: val })
      var re = /[0-9A-Fa-f]{6}/g;
      if (re.test(val)) {
        this.handleFormInput(new Color('#' + e.target.value, 0, 0, "Hex"))
      }
    }
  }

  render() {
    let baseColor = this.props.baseColor;
    const { hue, sat, light } = baseColor.hsl
    const { r, g, b } = baseColor.rgb
    let hexString = '#' + this.state.hexValue;

    return (
      <Card>
        
        <div id="color-picker">
        <ColorPickerCanvas onChange={this.props.changeBaseColor} baseColor={baseColor} setHexInput={this.setHexInput}/>
          <div id="canvases-container">
          </div>

          <div id="color-inputs-container">
            <div className="input-boxes">
              <div> H: {this.getNumberPickerInput('H', 359, hue, this.setFromHue)} </div>
              <div> S: {this.getNumberPickerInput('S', 100, sat, this.setFromSat)} </div>
              <div> L: {this.getNumberPickerInput('L', 100, light, this.setFromLight)} </div>
            </div>

            <div className="input-boxes">
              <div> R: {this.getNumberPickerInput('R', 255, r, this.setFromRed)}</div>
              <div> G: {this.getNumberPickerInput('G', 255, g, this.setFromGreen)}</div>
              <div> B: {this.getNumberPickerInput('B', 255, b, this.setFromBlue)} </div>
            </div>

            <div style={{ display: 'inline-block', verticalAlign: 'top', margin: '0px', width: '100%' }}>
              <div id='picked-color' style={{ backgroundColor: hexString }} />
              <div id='hex-intput'>
                Hex #: <Input id='hex-intput-txt-box' size="small" style={{ width: "82px" }} type="text" id="Hex" value={this.state.hexValue} onChange={this.setFromHex} />
              </div>
            </div>

          </div>

        </div>
      </Card>
    );
  }
}
export default connect(mapStateToProps, mapDispatchToProps)(ColorPicker);

import React, { Component } from "react";
import { Button, Navbar, Alignment } from "@blueprintjs/core";
import {  withRouter } from 'react-router-dom'

class Header extends Component {
  state = {
    newPaletteAnchor: null,
    loginAnchor: null,
    signUpAnchor: null
  };
  handleClickPalette = event => this.setState({ newPaletteAnchor: event.currentTarget });
  handleClosePalette = () => this.setState({ newPaletteAnchor: null });
  navigateTo = (link) => this.props.history.push(link);
  render() {

    return (
      <Navbar>
        <Navbar.Group align={Alignment.LEFT}>
            <Navbar.Heading>Awesome Color Palette Generator</Navbar.Heading>
            <Navbar.Divider />
            <Button className="bp3-minimal" icon="build" text="Generate Palette Style" onClick={() => this.navigateTo('/generate/hsl')}  />
            <Button className="bp3-minimal" icon="media" text="From Image" onClick={() => this.navigateTo('/generate/picture')}  />
            <Button className="bp3-minimal" icon="drag-handle-horizontal" text="Custom" onClick={() => this.navigateTo('/generate/custom')}  />
        </Navbar.Group>
      </Navbar>
    );
  }
}

export default withRouter(Header);

